{# ============================================================
   SERVICE HERO
   Reusable hero for Services group & category pages. Expects:
   - breadcrumbs (array, optional) -> passed to breadcrumbs.njk
   - heroKicker (string)
   - heroHeadline (string, may include `<span class="grad">...</span>`)
   - heroDescription (string)
   - heroImageSrc / heroImageAlt (strings, optional)
   - primaryCtaText / primaryCtaHref (strings, optional)
   - secondaryCtaText / secondaryCtaHref (strings, optional)
   ============================================================ #}
<section class="svc-hero">
  <div class="container">
    {% include "components/breadcrumbs.njk" %}
    <div class="svc-hero-inner">
      <div class="svc-hero-text reveal">
        <span class="svc-kicker">{{ heroKicker }}</span>
        <h1 class="svc-hero-title">{{ heroHeadline | safe }}</h1>
        <p class="svc-hero-desc">{{ heroDescription }}</p>
        <div class="svc-hero-ctas">
          <a href="{{ primaryCtaHref | default('/contact.html') }}" class="btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.68A2 2 0 012.18 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 8.15a16 16 0 006.94 6.94l1.42-1.41a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
            {{ primaryCtaText | default('Book Free Strategy Call') }}
          </a>
          <a href="{{ secondaryCtaHref | default('https://wa.me/923014422951') }}" target="_blank" rel="noopener" class="btn-ghost">
            {{ secondaryCtaText | default('Chat on WhatsApp') }}
          </a>
        </div>
      </div>
      <div class="svc-hero-visual reveal" style="transition-delay:.1s">
        <img src="{{ heroImageSrc }}" alt="{{ heroImageAlt }}" loading="eager"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
        <div class="svc-visual-fallback" style="display:none">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="3"/>
            <circle cx="8.5" cy="8.5" r="1.75"/>
            <path d="M21 15l-5-5L5 21"/>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>
